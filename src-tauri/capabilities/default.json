{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions du QLYGO Launcher : fenêtre launcher « main » ET fenêtre QlygoCAD « qlygocad » (où tourne l'éditeur, qui a besoin de http qlygo.fr + événements + fenêtre + process).",
  "windows": ["main", "qlygocad"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://qlygo.fr/*" }]
    }
  ]
}
