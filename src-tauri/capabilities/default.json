{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions par défaut de QlygoCAD (fenêtre principale).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://qlygo.fr/*" }]
    }
  ]
}
