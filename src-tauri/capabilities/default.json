{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions du QLYGO Launcher. ATTENTION : cette liste est par FENETRE. Toute fenetre qui charge une page LOCALE et appelle le serveur par le pont natif doit y figurer, sinon ses appels sont refuses en silence. main = launcher, qlygocad = editeur CAO, qlygo-drive = QLYGO Drive.",
  "windows": [
    "main",
    "qlygocad",
    "qlygo-drive"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://qlygo.fr/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://qlygo.fr/*"
        }
      ]
    },
    "dialog:allow-save",
    "upload:default"
  ]
}
