{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QlygoCAD",
  "version": "1.1.1",
  "identifier": "fr.qlygo.qlygocad",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node prepare-dist.mjs",
    "beforeDevCommand": "node prepare-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QlygoCAD",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© QLYGO",
    "category": "Productivity",
    "shortDescription": "CAO 2D pour l'urbanisme (DP02/DP03/DP04)",
    "longDescription": "QlygoCAD — éditeur CAO 2D à l'échelle pour les plans d'urbanisme (plan de masse DP02, plan de coupe DP03, plan de façade DP04). Dessin, cotation, hachures, export PDF et DXF."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/quentinfrancois-qlygo/QlygoCAD/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2RjNDN0Y1RjUyQzEwREMKUldUY0VDejE5Y2Z6QmtBek9vWit0cDVQMm1hRU04ditmOUxaSWxYNThOV0MyNEFjeEJTS0F6RU8K"
    }
  }
}
